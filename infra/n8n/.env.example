# Copy to `.env` on the VPS (gitignored) and fill in. Generate secrets with:
#   openssl rand -hex 32

# The domain you point at the VPS (A record). Caddy gets a TLS cert for it.
N8N_HOST=n8n.yourdomain.com
GENERIC_TIMEZONE=Asia/Almaty

# n8n credential encryption key — MUST be stable; losing it orphans stored creds.
N8N_ENCRYPTION_KEY=

# Postgres (n8n's own state DB — NOT your Supabase app DB)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
POSTGRES_DB=n8n

# Shared secret the Supabase Edge Function uses to HMAC-sign webhook calls;
# the n8n workflows verify it. Keep identical in both places.
N8N_WEBHOOK_SECRET=

# ── Local / home-hosting (docker-compose.local.yml, `npm run n8n`) ───────────
# N8N_HOST defaults to localhost locally; once you have a public tunnel URL, set
# WEBHOOK_URL to it so n8n registers publicly reachable webhooks.
WEBHOOK_URL=http://localhost:5678/

# Workflow env — read by $env.* inside the n8n nodes (main + worker both need these):
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
SUPABASE_URL=https://gdzbicfulgsawkegpbpx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Cloudflare Tunnel: leave empty to use a throwaway quick tunnel (random https URL,
# printed in the cloudflared logs). For a STABLE named tunnel, paste its token here and
# switch the cloudflared command to `tunnel --no-autoupdate run` in docker-compose.local.yml.
TUNNEL_TOKEN=
