{
  "name": "AIT Hub — Telegram connect",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "tg-connect",
        "responseMode": "onReceived",
        "options": { "responseCode": 200 }
      },
      "id": "node-webhook",
      "name": "Bot webhook (/start)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "ait-tg-connect",
      "notes": "Telegram posts bot updates here. No credential needed — set the bot webhook to https://<tunnel>/webhook/tg-connect (wire-telegram.sh does this). sendMessage below uses $env.TELEGRAM_BOT_TOKEN."
    },
    {
      "parameters": {
        "jsCode": "// Parse `/start <token>` (the Apply-modal deep-link payload) + the chat id.\n// Webhook wraps Telegram's update under `.body`; tolerate either shape.\nconst j = $input.first().json || {};\nconst u = j.body || j;\nconst msg = u.message || u;\nconst text = msg.text || '';\nconst chat_id = msg.chat && msg.chat.id;\nconst name = (msg.from && (msg.from.first_name || msg.from.username)) || '';\nconst m = text.match(/^\\/start\\s+(\\S+)/);\nreturn [{ json: { token: m ? m[1] : null, chat_id, name } }];"
      },
      "id": "node-parse",
      "name": "Parse start",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.token }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ]
        },
        "options": {}
      },
      "id": "node-if",
      "name": "Has token?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/applications?telegram_token=eq.{{ $json.token }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ telegram_chat_id: $json.chat_id }) }}",
        "options": {}
      },
      "id": "node-link",
      "name": "Link chat to application",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, -80]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $('Parse start').first().json.chat_id, text: 'Telegram connected ✅ — we will message you here when your application is reviewed.' }) }}",
        "options": {}
      },
      "id": "node-confirm",
      "name": "Confirm connected",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, -80],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $('Parse start').first().json.chat_id, text: 'Hi! Apply at AIT Hub first, then use the Connect Telegram button so we can link your application.' }) }}",
        "options": {}
      },
      "id": "node-help",
      "name": "Ask to use the app",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 120],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 3000
    }
  ],
  "connections": {
    "Bot webhook (/start)": { "main": [[{ "node": "Parse start", "type": "main", "index": 0 }]] },
    "Parse start": { "main": [[{ "node": "Has token?", "type": "main", "index": 0 }]] },
    "Has token?": {
      "main": [
        [{ "node": "Link chat to application", "type": "main", "index": 0 }],
        [{ "node": "Ask to use the app", "type": "main", "index": 0 }]
      ]
    },
    "Link chat to application": { "main": [[{ "node": "Confirm connected", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
