# Packages don't get to run code on install: the machine that publishes the site holds the keys,
# and a hijacked dependency's postinstall is how npm worms steal them. Nothing here needs it
# (esbuild and the Supabase CLI ship their binaries as ordinary packages).
ignore-scripts=true
# A hijacked version is usually caught within days: `npm install` doesn't take anything younger than
# a week. Works from npm 11.10; older versions skip the line. `npm ci` follows the lock file anyway.
min-release-age=7
audit-level=high
fund=false
