# Supabase — Project Settings > API in the Supabase dashboard.
# Copy this file to `.env.local` and fill in the values. `.env.local` is gitignored.
# Only the PUBLIC anon / publishable key belongs in the client bundle. Never put the
# service_role / secret key (or any secret) in a VITE_-prefixed variable — it ships to browsers.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry (optional) — the client DSN from your Sentry project (Settings > Client Keys).
# Leave blank to disable error reporting.
VITE_SENTRY_DSN=

# The club's address for the Hub (QR codes and the redirect from ait-hub.pages.dev).
# Set it only once the domain actually serves the Hub.
VITE_PUBLIC_ORIGIN=

# Cloudflare — only for publishing from your computer with `npm run deploy`.
# Deliberately NOT VITE_-prefixed: these must never end up in the site bundle. For automatic
# deploys put the same two values into GitHub → Settings → Secrets and variables → Actions.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
