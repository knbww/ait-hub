# Supabase — Project Settings > API Keys in the Supabase dashboard.
# Copy this file to `.env.local` and fill in the values. `.env.local` is gitignored.
# VITE_SUPABASE_ANON_KEY takes the PUBLISHABLE key (sb_publishable_…); the legacy anon /
# service_role keys are switched off in the club's project. Never put a secret key (sb_secret_…)
# or any other secret in a VITE_-prefixed variable — it ships to browsers.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry (optional) — the client DSN from your Sentry project (Settings > Client Keys).
# Leave blank to disable error reporting.
VITE_SENTRY_DSN=

# Cloudflare Turnstile site key (public) — bot protection on sign-in and sign-up. The matching
# secret key goes into Supabase (Authentication → Bot and Abuse Protection), not here.
VITE_TURNSTILE_SITE_KEY=

# The club's address for the Hub (QR codes and the redirect from ait-hub.pages.dev).
# Set it only once the domain actually serves the Hub.
VITE_PUBLIC_ORIGIN=

# Cloudflare — only for publishing from your computer with `npm run deploy`.
# Deliberately NOT VITE_-prefixed: these must never end up in the site bundle. For automatic
# deploys put the same two values into GitHub → Settings → Secrets and variables → Actions.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Demo copy (`npm run demo`) — a separate Supabase project filled with the fictional club from
# supabase/seed.sql, published at demo.ait-hub.pages.dev. Never the club's own project.
DEMO_SUPABASE_REF=
DEMO_SUPABASE_URL=
DEMO_SUPABASE_ANON_KEY=
# Session pooler connection string with the database password (port 5432).
DEMO_DB_URL=
DEMO_DB_PASSWORD=
