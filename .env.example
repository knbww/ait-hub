# Supabase — Project Settings > API in the Supabase dashboard.
# Copy this file to `.env.local` and fill in the values. `.env.local` is gitignored.
# Only the PUBLIC anon key belongs in the client bundle. NEVER put the
# service_role key (or any secret) in a VITE_-prefixed variable — it ships to browsers.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
