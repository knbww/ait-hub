# Supabase — Project Settings > API in the Supabase dashboard.
# Copy this file to `.env.local` and fill in the values. `.env.local` is gitignored.
# Only the PUBLIC anon key belongs in the client bundle. NEVER put the
# service_role key (or any secret) in a VITE_-prefixed variable — it ships to browsers.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry (optional) — the client DSN from your Sentry project (Settings > Client Keys).
# Client DSNs are designed to be public. Leave blank to disable error reporting.
VITE_SENTRY_DSN=

# Telegram onboarding bot @username (without the @), e.g. AitHubBot. When set, applicants
# get a "Connect Telegram" deep link after applying so the bot can DM them the decision +
# invite. Leave blank to keep the apply flow unchanged. Public by design.
VITE_TELEGRAM_BOT=
